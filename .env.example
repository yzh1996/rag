# Copy only the needed values into .env; never commit a real password.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=rag_qa_system
# An explicitly set DATABASE_URL takes precedence over MYSQL_*.
# DATABASE_URL=mysql+pymysql://user:encoded_password@127.0.0.1:3306/rag_qa_system?charset=utf8mb4
LLM_PROVIDER=openai
OPENAI_API_KEY=
API_HOST=localhost
API_PORT=8000
STREAMLIT_PORT=8501
AGENT_ENABLED=true
AGENT_MAX_ROUNDS=16
AGENT_MAX_TOOL_CALLS=24
AGENT_TIMEOUT_SECONDS=600
