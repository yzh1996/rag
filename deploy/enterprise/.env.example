POSTGRES_PASSWORD=replace-with-a-unique-password
OPENSEARCH_PASSWORD=ReplaceWithUnique_StrongPassword123!
MINIO_ROOT_USER=rag-storage-admin
MINIO_ROOT_PASSWORD=replace-with-a-unique-password
GRAFANA_PASSWORD=replace-with-a-unique-password
AUTH_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ALERT_RECEIVER_TOKEN=replace-with-a-random-alert-secret
ALERT_NOTIFICATION_URL=
# Email: use your mailbox SMTP authorization code, not an example password.
ALERT_EMAIL_ENABLED=false
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_FROM=
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_TO=
# DingTalk custom group robot; signing is recommended.
ALERT_DINGTALK_ENABLED=false
ALERT_DINGTALK_WEBHOOK=
ALERT_DINGTALK_SECRET=
ALERT_DINGTALK_TIMEOUT_SECONDS=10
# OCR settings for scanned PDF pages; Tencent mode sends page images to Tencent Cloud.
OCR_ENABLED=true
OCR_PROVIDER=tencent
OCR_DPI=150
TENCENT_OCR_SECRET_ID=
TENCENT_OCR_SECRET_KEY=
TENCENT_OCR_REGION=ap-guangzhou
TENCENT_OCR_ENDPOINT=https://ocr.tencentcloudapi.com
TENCENT_OCR_ACTION=GeneralBasicOCR
TENCENT_OCR_VERSION=2018-11-19
TENCENT_OCR_TIMEOUT_SECONDS=15
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
MODELS_HOST_PATH=../../models
